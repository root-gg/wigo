#!/bin/bash

# $1 is the action, $2 the previously configured version when there is one.
# Anything other than "configure" (abort-upgrade, abort-remove, ...) must not
# run the body of this script.
if [ "$1" != "configure" ] ; then
    exit 0
fi

echo "Installing WiGO on your system"

WIGOPATH="/usr/local/wigo"
EXAMPLEPROBES60=( hardware_load_average hardware_disks hardware_memory ifstat supervisord needrestart check_mdadm check_process haproxy lm-sensors iostat check_uptime )
EXAMPLEPROBES300=( smart check_ntp packages-apt )

# Fixing logrotate permissions
chown root:root /etc/logrotate.d/wigo

# Copy config file if not present on system
if [ ! -e /etc/wigo/wigo.conf ] ; then
    cp $WIGOPATH/etc/wigo.conf.sample /etc/wigo/wigo.conf
    echo "Config file /etc/wigo/wigo.conf created"
else
    echo "Config file /etc/wigo.conf already exists. Not overriding it.."
fi

# Copying probes config files if not present
CONFIGFILES=$(cd $WIGOPATH/etc/conf.d && ls *.conf)
for configFile in $CONFIGFILES; do 
    if [ ! -e /etc/wigo/conf.d/$configFile ] ; then
        echo "Copying probe conf file $configFile to /etc/wigo/conf.d/$configFile"
        cp $WIGOPATH/etc/conf.d/$configFile /etc/wigo/conf.d/$configFile
    fi
done

# Enabling default probes, on a fresh install only.
#
# Which probes are enabled and how often they run is expressed by the probes
# directory itself : a symlink under probes/<interval>/ pointing into
# probes/examples/, and no symlink at all when the probe is disabled. That state
# belongs to the administrator, and re-seeding it on every upgrade would undo
# their choices -- a disabled probe would come back, and one moved to another
# interval would end up running at both.
#
# Half of the probes shipped in probes/examples/ are deliberately left disabled
# here : they are for services most machines do not run.
if [ -z "$2" ] ; then
    echo "Enabling default probes.."

    cd $WIGOPATH/probes/60
    for probeName in ${EXAMPLEPROBES60[@]}; do
        if [ ! -e $probeName ] ; then
            echo " - Enabling $probeName every 60 seconds"
            ln -s ../examples/$probeName .
        else
            echo " - Probe $probeName already exists. Doing nothing.."
        fi
    done

    cd $WIGOPATH/probes/300
    for probeName in ${EXAMPLEPROBES300[@]}; do
        if [ ! -e $probeName ] ; then
            echo " - Enabling $probeName every 300 seconds"
            ln -s ../examples/$probeName .
        else
            echo " - Probe $probeName already exists. Doing nothing.."
        fi
    done
else
    echo "Upgrade from $2 : leaving the probes directory untouched"
fi

if [ -f /etc/init.d/wigo ] ; then
    /etc/init.d/wigo stop
    update-rc.d -f wigo remove
    rm -f /etc/init.d/wigo
    echo "Old init script removed"
fi

echo "Starting Wigo service"
# Start it
systemctl daemon-reload && systemctl enable wigo && systemctl restart wigo
